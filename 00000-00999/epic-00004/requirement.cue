package spec

schema: "specdock/v1"

assurance: {
	level:  "standard"
	reason: "外部のモデルに情報を渡す。渡す範囲を誤ると情報が外へ出るが、日誌そのものは作り直せる"
}

purpose: "集めた出来事を、安いモデルが話題（Story）にまとめ、書き手のモデル（Gemini 4 Neon）が「要約＋読み物」の日誌のMarkdownを書く。"

requirements: {
	"R-01": {
		title: "分析と書き手のモデルを、設定の経路の名前で選べる"
		acceptance: ["経路 `codex`、`antigravity`、`claude`、`fake` がある", "試験は `fake` で、外部を呼ばずに通る"]
	}
	"R-02": {
		title: "分析のモデルが、その日の出来事を話題（Story）にまとめる"
		acceptance: ["関係する出来事が1つの話題にまとまり、何を・なぜ・人が知るべきこと・人を待つこと・ネタポイント（0〜3）が付く", "結果は決まったJSONの形で、形が合わなければ1回だけ頼み直す"]
	}
	"R-03": {
		title: "書き手のモデルが、話題から日誌の本文を書き、日誌のMarkdownのファイルができる"
		acceptance: ["`shipcast write --repo <id> --date <日付>` で、epic-00004 の D-04 の形のファイルができる", "文体は「要約＋読み物」（です・ます調）"]
	}
	"R-04": {
		title: "出来事のない日は、モデルを呼ばずに短い日誌にする"
		acceptance: ["Eventが0件の日は、モデルの呼び出しが0回で、1行の日誌ができる"]
	}
}

failures: {
	"F-01": {title: "モデルの呼び出しが失敗したときは、話題と出来事を状態に残し、前の日誌のファイルを壊さずに失敗として記録する"}
	"F-02": {title: "秘密情報らしい文字列（トークン、鍵、パスワードの行）は、モデルに渡す前に伏せる"}
	"F-03": {title: "エージェントの中（`CLAUDECODE`、`CODEX_` で始まる環境変数、Orcaの作業者の印）では、`antigravity` の経路は呼ばずに止まる"}
	"F-04": {title: "書き手のモデルの文章が、話題にない事実を足さないよう、骨組みだけを渡し、創作を禁じる指示を付ける"}
}
