package spec

schema: "specdock/v1"

assurance: {
	level:  "strict"
	reason: "外部のモデル（Codex・Gemini）へ情報を送る境界と、エージェントの中から `agy` を呼ばない守りを持つ（子の iss-00014 が strict）。渡す範囲を誤ると秘密情報が外部へ出て取り消せず、`agy` の誤った呼び出しは規約に反する。日誌そのものは作り直せる"
}

purpose: "集めた出来事を、安いモデルが話題（Story）にまとめ、書き手のモデル（Gemini 4 Neon）が「要約＋読み物」の日誌のMarkdownを書く。"

requirements: {
	"R-01": {
		title: "分析と書き手のモデルを、設定の経路の名前で選べる"
		acceptance: ["経路 `codex`、`antigravity`、`claude`、`fake` がある", "試験は `fake` で、外部を呼ばずに通る"]
	}
	"R-02": {
		title: "分析のモデルが、その日の出来事を話題（Story）にまとめる"
		acceptance: ["関係する出来事が1つの話題にまとまり、何を・なぜ・人が知るべきこと・人を待つこと・ネタポイント（0〜3）が付く", "結果は決まったJSONの形で、形が合わなければ1回だけ頼み直す"]
	}
	"R-03": {
		title: "書き手のモデルが、話題から日誌の本文を書き、日誌のMarkdownのファイルができる"
		acceptance: ["`shipcast write --repo <id> --date <日付>` で、epic-00002 の D-05 のパスと前付け、D-04 の本文の形のファイルができる", "文体は「要約＋読み物」（です・ます調）"]
	}
	"R-04": {
		title: "出来事のない日は、モデルを呼ばずに短い日誌にする"
		acceptance: ["Eventが0件の日は、モデルの呼び出しが0回で、1行の日誌ができる"]
	}
	"R-05": {
		title: "`:::metrics` の数字は、その日の出来事（events）から機械で数える"
		acceptance: ["日誌の組み立ては話題と一緒に events を受け取り、merge・commit・閉じたScope・本人待ちのtodoの数が出来事と一致する"]
	}
	"R-06": {
		title: "日誌の末尾に囲みを足す拡張点がある"
		text:  "おまけ（epic-00006 の iss-00019）が「発信の芽」をここに足す。拡張点がないと、おまけが書く段の中を書き換えることになる。"
		acceptance: ["拡張点に部品を登録すると、その囲みが `:::metrics` の後に足され、登録がなければ日誌は変わらない"]
	}
}

failures: {
	"F-01": {
		title:    "モデルの呼び出しが失敗したときは、話題と出来事を状態に残し、前の日誌のファイルを壊さずに失敗として記録する"
		impact:   "途中まで書いたファイルで前の日誌が消え、集めた材料も失う"
		recovery: "材料はモデルを呼ぶ前に保存し、日誌は一時ファイルから `os.replace` で置き換える。次の実行で同じ材料から書き直す"
	}
	"F-02": {
		title:    "秘密情報らしい文字列（トークン、鍵、パスワードの行）は、モデルに渡す前に伏せる"
		impact:   "外部のモデルへ秘密情報が送られ、取り消せない"
		recovery: "伏せる処理を経路の共通の入口に置き、経路の実装から飛ばせないようにする。伏せる処理が失敗したら送らずに止める。漏れた疑いがあれば、その秘密を作り直す"
	}
	"F-03": {
		title:    "エージェントの中（`CLAUDECODE`・`AI_AGENT`・`ORCA_AGENT_SESSION_ID`・`CODEX_` で始まる環境変数）では、`antigravity` の経路は呼ばずに止まる"
		impact:   "エージェントやOrcaの作業者が `agy` を包んで使う形になり、Antigravityの規約に反する"
		recovery: "判定は子のプロセスを作る前に行い、閉じる側に倒す。試験は偽のrunnerと `fake` の経路だけを使う"
	}
	"F-04": {
		title:    "書き手のモデルの文章が、話題にない事実を足さないよう、骨組みだけを渡し、創作を禁じる指示を付ける"
		impact:   "本人が誤った事実を日誌から信じ、判断を誤る"
		recovery: "書き手に渡すのは話題の骨組み（JSON）だけにし、数字と前付けは機械で作る。誤りに気づいたら、同じ日を実行し直す"
	}
}
